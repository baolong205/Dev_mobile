PORT=3000
MQTT_URL=mqtt://192.168.1.10:1883
MQTT_TOPIC=smartstore/sensors/data
# Tài khoản "backend" trong mosquitto/config/passwd (xem scripts/mqtt-users.ps1).
MQTT_USERNAME=backend
MQTT_PASSWORD=
MONGO_URI=mongodb://127.0.0.1:27017/smartstore
NODE_ENV=development
DEBUG_SENSOR=false
# Blank = reflect development origins. Production requires explicit comma-separated origins.
CORS_ORIGIN=

# Bắt buộc, >= 32 ký tự ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Tạo admin đầu tiên khi database chưa có người dùng (có thể xóa sau lần chạy đầu).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# true = chỉ cho thao tác ghi từ IP LAN/private (mặc định). Đặt false khi chạy sau reverse proxy công khai.
LAN_ONLY_WRITES=true
# true khi backend đứng sau reverse proxy (dùng X-Forwarded-For cho rate limit).
TRUST_PROXY=false
