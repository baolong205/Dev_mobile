# Dùng cho docker compose và scripts/mqtt-users.ps1. Sao chép thành .env (không commit).
# Mật khẩu MQTT: tối thiểu 12 ký tự, không chứa dấu nháy/khoảng trắng.
MQTT_BACKEND_PASSWORD=
MQTT_ESP32_PASSWORD=
MQTT_HEALTHCHECK_PASSWORD=

# Backend chạy trong Docker (service "backend").
# Chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Tài khoản admin được tạo lần đầu khi database chưa có người dùng nào.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BACKEND_PORT=3000
CORS_ORIGIN=
