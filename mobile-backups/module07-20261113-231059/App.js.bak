import React, { useEffect, useState } from 'react';
import { SafeAreaView, ScrollView, View, Text, TextInput, Pressable, StyleSheet, Alert } from 'react-native';

export default function App() {
  const [ip, setIp] = useState('192.168.1.10');
  const [serverIp, setServerIp] = useState('');
  const [reading, setReading] = useState(null);
  const [status, setStatus] = useState('Chưa kết nối');
  const base = `http://${serverIp}:3000`;
  useEffect(() => {
    if (!serverIp) return;
    let alive = true;
    const poll = async () => {
      try {
        const res = await fetch(`${base}/api/latest`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        if (alive) { setReading(data.temperature == null ? null : data); setStatus('Đã kết nối API'); }
      } catch (err) { if (alive) setStatus('Mất kết nối: ' + err.message); }
    };
    poll();
    const timer = setInterval(poll, 2000);
    return () => { alive = false; clearInterval(timer); };
  }, [serverIp]);
  const command = async (mode) => {
    if (!serverIp) return Alert.alert('Chưa kết nối', 'Hãy nhập IP máy tính chạy Backend');
    try {
      const res = await fetch(`${base}/api/led`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode }) });
      if (!res.ok) throw new Error(await res.text());
      Alert.alert('Đã gửi lệnh', `Chế độ: ${mode}`);
    } catch (err) { Alert.alert('Lỗi gửi lệnh', err.message); }
  };
  return <SafeAreaView style={styles.root}><ScrollView contentContainerStyle={styles.container}>
    <Text style={styles.title}>🏪 SmartStore</Text>
    <Text style={styles.subtitle}>Giám sát cửa hàng thông minh • MQTT</Text>
    <View style={styles.card}>
      <Text style={styles.label}>IP máy tính chạy Backend (không phải IP ESP32)</Text>
      <TextInput style={styles.input} value={ip} onChangeText={setIp} autoCapitalize="none" keyboardType="numbers-and-punctuation" placeholder="192.168.1.10" />
      <Pressable style={styles.button} onPress={() => setServerIp(ip.trim())}><Text style={styles.buttonText}>Kết nối</Text></Pressable>
      <Text style={styles.status}>{status}</Text>
    </View>
    <View style={styles.row}>
      <View style={[styles.card, styles.half]}><Text style={styles.metric}>🌡️ {reading?.temperature ?? '--'}°C</Text><Text>Nhiệt độ</Text></View>
      <View style={[styles.card, styles.half]}><Text style={styles.metric}>💧 {reading?.humidity ?? '--'}%</Text><Text>Độ ẩm</Text></View>
    </View>
    <View style={styles.card}>
      <Text style={styles.heading}>Cảm biến PIR</Text>
      <Text style={styles.metric}>{reading ? (reading.motion ? '🟢 Có chuyển động' : '🔴 Không chuyển động') : 'Chưa có dữ liệu'}</Text>
      <Text>LED xanh: {reading ? (reading.greenLed ? 'BẬT' : 'TẮT') : '--'}</Text>
      <Text>LED đỏ: {reading ? (reading.redLed ? 'BẬT' : 'TẮT') : '--'}</Text>
    </View>
    <View style={styles.card}>
      <Text style={styles.heading}>Điều khiển LED</Text>
      <View style={styles.controls}>{[['Tự động','auto'],['Bật xanh','green'],['Bật đỏ','red'],['Tắt cả hai','off']].map(([label, mode]) =>
        <Pressable key={mode} style={styles.control} onPress={() => command(mode)}><Text style={styles.controlText}>{label}</Text></Pressable>)}</View>
      <Text style={styles.hint}>Chế độ tự động: có chuyển động → xanh; không có → đỏ.</Text>
    </View>
  </ScrollView></SafeAreaView>;
}
const styles = StyleSheet.create({
  root: { flex: 1, backgroundColor: '#f1f5f9' }, container: { padding: 20, paddingBottom: 50 },
  title: { fontSize: 30, fontWeight: '800', color: '#0f172a', marginTop: 15 }, subtitle: { color: '#64748b', marginBottom: 18 },
  card: { backgroundColor: 'white', borderRadius: 16, padding: 17, marginBottom: 14 },
  label: { fontWeight: '600', marginBottom: 8, color: '#334155' }, input: { borderWidth: 1, borderColor: '#cbd5e1', borderRadius: 10, padding: 12, marginBottom: 10 },
  button: { backgroundColor: '#2563eb', padding: 13, borderRadius: 10, alignItems: 'center' }, buttonText: { color: 'white', fontWeight: '700' },
  status: { color: '#475569', marginTop: 10 }, row: { flexDirection: 'row', gap: 12 }, half: { flex: 1 }, metric: { fontSize: 21, fontWeight: '800', color: '#0f172a', marginBottom: 8 },
  heading: { fontSize: 17, fontWeight: '700', marginBottom: 12 }, controls: { flexDirection: 'row', flexWrap: 'wrap', gap: 8 },
  control: { backgroundColor: '#dbeafe', borderRadius: 9, padding: 12 }, controlText: { color: '#1d4ed8', fontWeight: '700' },
  hint: { marginTop: 12, color: '#64748b' }
});
